{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-webtoon.dev/schemas/v1/story-bible.schema.json",
  "title": "Story Bible",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "project", "premise", "themes", "world", "characters", "timeline", "story_engine", "continuity_rules"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "story_bible"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "language", "genre", "audience"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "title": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 2},
        "genre": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "audience": {"type": "string", "minLength": 1}
      }
    },
    "premise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logline", "series_question", "promise"],
      "properties": {
        "logline": {"type": "string", "minLength": 10},
        "series_question": {"type": "string", "minLength": 5},
        "promise": {"type": "string", "minLength": 5}
      }
    },
    "themes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}, "uniqueItems": true},
    "world": {
      "type": "object",
      "required": ["era", "locations", "rules"],
      "properties": {
        "era": {"type": "string"},
        "locations": {"type": "array", "items": {"type": "object", "required": ["id", "name", "function"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "function": {"type": "string"}}}},
        "rules": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role", "age_at_start", "want", "need", "conflict", "voice", "growth_arc", "identity_lock"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "name": {"type": "string", "minLength": 1},
          "role": {"type": "string"},
          "age_at_start": {"type": "integer", "minimum": 0, "maximum": 150},
          "want": {"type": "string"},
          "need": {"type": "string"},
          "conflict": {"type": "string"},
          "voice": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "growth_arc": {
            "type": "object",
            "additionalProperties": false,
            "required": ["physical_and_social", "role_progression", "emotional"],
            "properties": {
              "physical_and_social": {"type": "string"},
              "role_progression": {"type": "string"},
              "emotional": {"type": "string"}
            }
          },
          "past_life": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["role", "age_at_death", "failure", "core_wound"],
            "properties": {
              "role": {"type": "string"},
              "age_at_death": {"type": "integer", "minimum": 0, "maximum": 200},
              "failure": {"type": "string"},
              "core_wound": {"type": "string"}
            }
          },
          "identity_lock": {
            "type": "object",
            "additionalProperties": false,
            "required": ["silhouette", "face", "hair", "body", "palette", "signature_items"],
            "properties": {
              "silhouette": {"type": "string"},
              "face": {"type": "string"},
              "hair": {"type": "string"},
              "body": {"type": "string"},
              "palette": {"type": "array", "minItems": 2, "items": {"type": "string"}},
              "signature_items": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calendar", "start", "aging_policy", "milestones"],
      "properties": {
        "calendar": {"type": "string", "minLength": 1},
        "start": {
          "type": "object",
          "additionalProperties": false,
          "required": ["year", "season"],
          "properties": {
            "year": {"type": "integer", "minimum": 0},
            "season": {"type": "string", "minLength": 1}
          }
        },
        "aging_policy": {"const": "calendar_continuous"},
        "milestones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "year", "label", "age_by_character"],
            "properties": {
              "id": {"type": "string", "pattern": "^(season|arc)-[0-9]{3,}$"},
              "year": {"type": "integer", "minimum": 0},
              "label": {"type": "string", "minLength": 1},
              "age_by_character": {
                "type": "object",
                "minProperties": 1,
                "patternProperties": {
                  "^[a-z0-9][a-z0-9-]*$": {"type": "integer", "minimum": 0, "maximum": 150}
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "story_engine": {
      "type": "object",
      "required": ["episode_pattern", "escalation", "season_arc"],
      "properties": {
        "episode_pattern": {"type": "string"},
        "escalation": {"type": "string"},
        "season_arc": {"type": "string"}
      },
      "additionalProperties": true
    },
    "continuity_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
