{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-webtoon.dev/schemas/v1/territory-profile.schema.json",
  "title": "Territory Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "territory_id", "name", "seat", "geography", "climate", "resources", "population", "infrastructure", "chronic_problems", "disaster_exposure", "development_constraints", "continuity_rules"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "territory_profile"},
    "territory_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "seat": {"$ref": "#/$defs/namedText"},
    "geography": {
      "type": "object", "additionalProperties": false,
      "required": ["regional_position", "landforms", "watershed", "settlement_pattern", "visual_anchors"],
      "properties": {
        "regional_position": {"$ref": "#/$defs/text"},
        "landforms": {"$ref": "#/$defs/textList"},
        "watershed": {"$ref": "#/$defs/text"},
        "settlement_pattern": {"$ref": "#/$defs/text"},
        "visual_anchors": {"$ref": "#/$defs/textList"}
      }
    },
    "climate": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "annual_cycle"],
      "properties": {
        "classification": {"$ref": "#/$defs/text"},
        "annual_cycle": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/season"}}
      }
    },
    "resources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/resource"}},
    "population": {
      "type": "object", "additionalProperties": false,
      "required": ["estimated_total", "settlements", "demographic_pressure"],
      "properties": {
        "estimated_total": {"type": "integer", "minimum": 1},
        "settlements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/settlement"}},
        "demographic_pressure": {"$ref": "#/$defs/text"}
      }
    },
    "infrastructure": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/infrastructure"}},
    "chronic_problems": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/problem"}},
    "disaster_exposure": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/exposure"}},
    "development_constraints": {"$ref": "#/$defs/textList"},
    "continuity_rules": {"$ref": "#/$defs/textList"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "textList": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "namedText": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "location", "function"],
      "properties": {"name": {"$ref": "#/$defs/text"}, "location": {"$ref": "#/$defs/text"}, "function": {"$ref": "#/$defs/text"}}
    },
    "season": {
      "type": "object", "additionalProperties": false,
      "required": ["season", "conditions", "territory_effect"],
      "properties": {"season": {"$ref": "#/$defs/text"}, "conditions": {"$ref": "#/$defs/text"}, "territory_effect": {"$ref": "#/$defs/text"}}
    },
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "availability", "current_barrier", "potential"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "name": {"$ref": "#/$defs/text"}, "availability": {"$ref": "#/$defs/text"}, "current_barrier": {"$ref": "#/$defs/text"}, "potential": {"$ref": "#/$defs/text"}}
    },
    "settlement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "population", "livelihood"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "name": {"$ref": "#/$defs/text"}, "population": {"type": "integer", "minimum": 1}, "livelihood": {"$ref": "#/$defs/text"}}
    },
    "infrastructure": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "status", "function", "failure_mode"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "name": {"$ref": "#/$defs/text"}, "status": {"$ref": "#/$defs/text"}, "function": {"$ref": "#/$defs/text"}, "failure_mode": {"$ref": "#/$defs/text"}}
    },
    "problem": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "symptom", "root_causes", "downstream_effects", "latent_opportunity", "decision_owners"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "title": {"$ref": "#/$defs/text"}, "symptom": {"$ref": "#/$defs/text"}, "root_causes": {"$ref": "#/$defs/textList"}, "downstream_effects": {"$ref": "#/$defs/textList"}, "latent_opportunity": {"$ref": "#/$defs/text"}, "decision_owners": {"$ref": "#/$defs/textList"}}
    },
    "exposure": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "trigger_conditions", "vulnerabilities", "possible_consequences", "scenario_not_scheduled"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "trigger_conditions": {"$ref": "#/$defs/textList"}, "vulnerabilities": {"$ref": "#/$defs/textList"}, "possible_consequences": {"$ref": "#/$defs/textList"}, "scenario_not_scheduled": {"const": true}}
    }
  }
}
