{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-webtoon.dev/schemas/v1/scroll-plan.schema.json",
  "title": "Vertical Scroll Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "episode_id", "target_master_width_px", "sequences"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "scroll_plan"},
    "episode_id": {"type": "string", "pattern": "^ep[0-9]{3,}$"},
    "target_master_width_px": {"type": "integer", "minimum": 320},
    "sequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "beat_refs", "rhythm", "reveal", "whitespace_before_px", "whitespace_after_px", "estimated_height_px", "shot_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^seq-[0-9]{3,}$"},
          "beat_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "rhythm": {"enum": ["compressed", "normal", "expanded", "splash"]},
          "reveal": {"type": "string"},
          "whitespace_before_px": {"type": "integer", "minimum": 0},
          "whitespace_after_px": {"type": "integer", "minimum": 0},
          "estimated_height_px": {"type": "integer", "minimum": 1},
          "shot_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^shot-[0-9]{3,}$"}},
          "bridge_inserts": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["shot_id", "after_shot_id"],
              "properties": {
                "shot_id": {"type": "string", "pattern": "^shot-[0-9]{3,}$"},
                "after_shot_id": {"type": "string", "pattern": "^shot-[0-9]{3,}$"}
              }
            }
          }
        }
      }
    }
  }
}
